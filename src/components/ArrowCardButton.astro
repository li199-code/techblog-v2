---
type Props = {
  href: string;
  text: string;
  textAbove?: string;
  textBelow?: string;
  pinned?: boolean;
  openInNewTab?: boolean;
};

const {
  href,
  text,
  textAbove,
  textBelow,
  pinned = false,
  openInNewTab = false,
} = Astro.props;
---

<a
  href={href}
  class="not-prose group relative flex flex-nowrap rounded-lg border border-black/15 px-4 py-3 pr-10 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
  style="min-height: 70px; text-decoration: none;"
  {...openInNewTab ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <div
    class="flex flex-1 flex-col truncate"
    style="display: flex; justify-content: center;"
  >
    {textAbove && <div class="text-xs text-gray-500">{textAbove}</div>}
    <div class="flex min-w-0 items-center gap-2 font-semibold">
      {
        pinned && (
          <span
            class="inline-flex size-5 shrink-0 items-center justify-center rounded bg-amber-500/10 text-amber-700 dark:text-amber-400"
            title="置顶"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="size-3.5 fill-none stroke-current"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M16 3H8l1 7-4 4v2h14v-2l-4-4 1-7Z" />
              <path d="M12 16v6" />
            </svg>
            <span class="sr-only">置顶文章</span>
          </span>
        )
      }
      <span class="truncate">{text}</span>
    </div>
    {textBelow && <div class="text-xs text-gray-500">{textBelow}</div>}
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
    ></polyline>
  </svg>
</a>
